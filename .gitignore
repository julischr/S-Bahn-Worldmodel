# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# data files (raw + derived matrices are large / regenerable -- never commit)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/01_muenchen/*
!data/01_muenchen/.gitkeep
data/02_events/*
!data/02_events/.gitkeep
data/03_state_vector/*
!data/03_state_vector/.gitkeep

# outputs/ holds small analysis results (CSVs, plots, logs) -- these ARE meant
# to be committed, so nothing under outputs/ is ignored here.

# Test / Experiment files
*.ipynb

# Virtual environments
.venv
